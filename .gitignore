# cron output — noisy, regenerated constantly
forecast_cron.log

# mock data for previewing the forecast page; not real, would confuse anyone reading the repo
forecast_preview.html

__pycache__/
*.pyc
.DS_Store

# schedule table backups written by make_schedules.py
.schedule_backup/

# python venv for satellite.py (h5py) - rebuildable, not source.
# Glob, not a literal: renaming venv -> venv_off to test the no-venv fallback moved it
# outside a bare 'venv/' rule and publish.sh's `git add -A` committed 40 MB of binaries.
venv*/
*.so

# one-time pre-compaction copy of the history; git holds every version anyway
forecast_history.precompact.json

# notification state — local, not source
.notify_trip.json

# ntfy topic — effectively a shared secret, never committed
.ntfy_topic

# nightwatch: a cron log that appends every 15 min, a derived mask rebuildable from
# daylight frames, and the output of a retired script. forecast_cron.log is already
# ignored for the same reason — these were the inconsistency.
nightwatch.log
skymask.npy
stars_log.json
platesolve_residuals.json
shots/
schedule_wx.json
best_nights.log
home_nights.json
home_nights.log
compare.html
